<footer class="site-footer">
	<div class="container-page">
		<div class="grid gap-10 md:grid-cols-2 lg:grid-cols-4">
			@foreach (FooterColumn column in Columns)
			{
				<nav aria-label="@column.Title">
					<h2 class="eyebrow mb-5">@column.Title</h2>
					<ul class="stack gap-3">
						@foreach (string link in column.Links)
						{
							<li><a class="link-quiet" href="#">@link</a></li>
						}
					</ul>
				</nav>
			}
		</div>

		<div class="hairline mt-16 flex flex-col-reverse gap-6 pt-8 md:flex-row md:items-center md:justify-between">
			<p class="caption">© @DateTime.Now.Year Atelier. All rights reserved.</p>
			<p class="wordmark">Atelier</p>
		</div>
	</div>
</footer>

@code {
	private sealed record FooterColumn(string Title, string[] Links);

	private static readonly FooterColumn[] Columns =
	[
		new("Client services", ["Contact us", "Shipping", "Returns and exchanges", "Care guide"]),
		new("The house", ["Our atelier", "Craftsmanship", "Sustainability", "Careers"]),
		new("Legal", ["Terms of sale", "Privacy policy", "Cookie settings", "Accessibility"]),
		new("Follow", ["Instagram", "Pinterest", "Journal"]),
	];
}
