<article class="product-card">
	@if (Product.StockState is StockState.SoldOut)
	{
		<span class="badge">Sold out</span>
	}
	else if (Product.Badge is not null)
	{
		<span class="badge">@Product.Badge</span>
	}
	<div class="product-card-media">
		<img src="@UnsplashImage.Url(Product.ImageId, 600)"
			srcset="@UnsplashImage.SrcSet(Product.ImageId, 400, 600, 900)"
			sizes="(min-width: 80rem) 25vw, (min-width: 48rem) 33vw, 50vw"
			alt="" loading="lazy" decoding="async" width="600" height="800" />
	</div>
	<div class="product-card-body">
		<p class="caption">@Product.Category</p>
		@if (HeadingLevel == 2)
		{
			<h2 class="product-card-name">@NameLink</h2>
		}
		else
		{
			<h3 class="product-card-name">@NameLink</h3>
		}
		<p class="product-card-price"><ProductPrice Product="Product" /></p>
	</div>
</article>

@code {
	[Parameter, EditorRequired] public Product Product { get; set; } = default!;

	/// <summary>Heading level of the product name: 3 under a section's <c>h2</c> (the default), 2 when the grid sits directly under the page's <c>h1</c>.</summary>
	[Parameter] public int HeadingLevel { get; set; } = 3;

	private RenderFragment NameLink => @<a class="product-card-link" href="products/@Product.Slug">@Product.Name</a>;
}
