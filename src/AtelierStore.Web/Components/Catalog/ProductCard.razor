@using System.Globalization

<article class="product-card">
	@if (Product.Badge is not null)
	{
		<span class="badge">@Product.Badge</span>
	}
	<div class="product-card-media">
		<img src="@UnsplashImage.Url(Product.ImageId, 600)"
			srcset="@UnsplashImage.SrcSet(Product.ImageId, 400, 600, 900)"
			sizes="(min-width: 80rem) 25vw, (min-width: 48rem) 33vw, 50vw"
			alt="" loading="lazy" decoding="async" width="600" height="800" />
	</div>
	<div class="product-card-body">
		<p class="caption">@Product.Category</p>
		<h3 class="product-card-name">
			<a class="product-card-link" href="products/@Product.Slug">@Product.Name</a>
		</h3>
		<p class="product-card-price">
			@if (Product.WasPrice is { } was)
			{
				<span class="sr-only">Sale price</span>
				<span class="price-sale">@Format(Product.Price)</span>
				<span class="sr-only">, was</span>
				<s class="price-was ml-2">@Format(was)</s>
			}
			else
			{
				@Format(Product.Price)
			}
		</p>
	</div>
</article>

@code {
	private static readonly CultureInfo PriceCulture = CultureInfo.GetCultureInfo("en-US");

	[Parameter, EditorRequired] public Product Product { get; set; } = default!;

	private static string Format(decimal amount) => amount.ToString("C0", PriceCulture);
}
