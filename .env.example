# Copy to .env and fill in. Loaded at startup by DotNetEnv; real environment
# variables take precedence. Double underscore (__) maps to ":" in .NET config.

ASPNETCORE_ENVIRONMENT=Development

# PostgreSQL (matches docker-compose.yml defaults)
POSTGRES_USER=atelier
POSTGRES_PASSWORD=atelier
POSTGRES_DB=atelier_store
ConnectionStrings__Default=Host=localhost;Port=5432;Database=atelier_store;Username=atelier;Password=atelier

# Auth0 — Regular Web Application
# Allowed Callback URLs: https://localhost:7207/callback
# Allowed Logout URLs:   https://localhost:7207/
Auth0__Domain=your-tenant.us.auth0.com
Auth0__ClientId=
Auth0__ClientSecret=
